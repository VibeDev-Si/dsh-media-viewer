{
  "name": "@vibedev-si/dsh-media-viewer",
  "version": "0.2.0",
  "description": "右侧栏媒体预览：直接预览视频、音频和 HTML（大文件可拖进度条，HTML 默认允许脚本），文件夹媒体画廊（多选后加入影视工作台画布）；用 DSH 自带的右侧栏，装了 dsh-better-sidebar 时也在其中可用 · Inline video, audio and HTML preview plus a folder media gallery in the host's own right sidebar (and inside dsh-better-sidebar when installed) — range-streamed large files, sandboxed HTML with working relative assets",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vibedev",
    "right-sidebar",
    "video",
    "audio",
    "html",
    "preview",
    "gallery",
    "file-viewer",
    "dsh-better-sidebar"
  ],
  "author": "CrisLIUning",
  "license": "MIT",
  "homepage": "https://github.com/VibeDev-Si/dsh-media-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibeDev-Si/dsh-media-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/VibeDev-Si/dsh-media-viewer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test/route.test.mjs && node test/tokens.test.mjs && node test/add-to-canvas.test.mjs && node test/host-surface.test.mjs"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
